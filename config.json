{
    "name": "REDCap ServiceNow Catalog Integration",
    "namespace": "YaleREDCap\\REDCapServiceNowCatalogIntegration",
    "description": "Integrates REDCap with a ServiceNow catalog, allowing users to submit requests directly from REDCap by mapping REDCap fields to ServiceNow catalog item fields.",
    "documentation": "README.md",
    "authors": [
        {
            "name": "Andrew Poppe",
            "email": "andrew.poppe@yale.edu",
            "institution": "Yale University"
        }
    ],
    "framework-version": 16,
    "links": {
        "project": [
            {
                "name": "ServiceNow Catalog Integration",
                "icon": "fas fa-cogs",
                "url": "pages/config.php",
                "show-header-and-footer": true
            }
        ]
    },
    "project-settings": [
        {
            "key": "servicenow-instance-url",
            "name": "ServiceNow Instance URL",
            "type": "text",
            "required": false,
            "hidden": true
        },
        {
            "key": "servicenow-username",
            "name": "ServiceNow Username",
            "type": "text",
            "required": false,
            "hidden": true
        },
        {
            "key": "servicenow-password",
            "name": "ServiceNow Password",
            "type": "password",
            "required": false,
            "hidden": true
        },
        {
            "key": "catalog-items",
            "name": "Catalog Items",
            "type": "sub_settings",
            "repeatable": true,
            "hidden": true,
            "sub_settings": [
                {
                    "key": "catalog-item-label",
                    "name": "Label",
                    "type": "text",
                    "required": false,
                    "hidden": true
                },
                {
                    "key": "catalog-item-active",
                    "name": "Active",
                    "type": "checkbox",
                    "required": false,
                    "hidden": true
                },
                {
                    "key": "catalog-item-sys-id",
                    "name": "Catalog Item sys_id",
                    "type": "text",
                    "required": false,
                    "hidden": true
                },
                {
                    "key": "catalog-item-field-mappings",
                    "name": "Field Mappings (JSON)",
                    "type": "text",
                    "required": false,
                    "hidden": true
                },
                {
                    "key": "catalog-item-value-mappings",
                    "name": "Value Mappings (JSON)",
                    "type": "text",
                    "required": false,
                    "hidden": true
                },
                {
                    "key": "catalog-item-attachment-fields",
                    "name": "Attachment Fields (JSON)",
                    "type": "text",
                    "required": false,
                    "hidden": true
                },
                {
                    "key": "catalog-item-snapshot",
                    "name": "Field Snapshot (JSON)",
                    "type": "text",
                    "required": false,
                    "hidden": true
                },
                {
                    "key": "catalog-item-trigger-form",
                    "name": "Trigger Form",
                    "type": "text",
                    "required": false,
                    "hidden": true
                },
                {
                    "key": "catalog-item-trigger-criteria",
                    "name": "Trigger Criteria (JSON)",
                    "type": "text",
                    "required": false,
                    "hidden": true
                },
                {
                    "key": "catalog-item-failure-emails",
                    "name": "Failure Notification Emails (JSON)",
                    "type": "text",
                    "required": false,
                    "hidden": true
                }
            ]
        }
    ],
    "enable-ajax-logging": true,
    "auth-ajax-actions": [
        "deleteCatalogItem",
        "deleteConnectionSettings",
        "getServiceNowFields",
        "getSubmissionLog",
        "saveCatalogItem",
        "saveConnectionSettings",
        "submitCatalogRequest",
        "testConnection"
    ],
    "compatibility": {
        "php-version-min": "8.0.0",
        "redcap-version-min": "15.0.9"
    }
}